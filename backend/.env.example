# FastAPI
ENVIRONMENT=development
DEBUG=false

# Generate a unique local secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Exact HTTP(S) origins only; in production set the real Vercel domain.
CORS_ORIGINS=["http://localhost:3000"]

# Backend only. SUPABASE_KEY must be a server-side secret/service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=REPLACE_WITH_SERVER_SIDE_SECRET_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_OR_PUBLISHABLE_KEY

BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Finanzy
