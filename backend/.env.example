# FastAPI
ENVIRONMENT=development
DEBUG=false
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca subir el valor real al repositorio.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Lista JSON de orígenes exactos; en producción indicar el dominio real de Vercel.
CORS_ORIGINS=["http://localhost:3000"]

# SUPABASE_KEY es exclusivamente server-side. No usar en variables NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=REPLACE_WITH_SERVER_SIDE_SECRET_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_OR_PUBLISHABLE_KEY

BREVO_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=
FROM_NAME=Finanzy
