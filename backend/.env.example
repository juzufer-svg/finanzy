# FastAPI Configuration
# En Railway: ENVIRONMENT=production (oculta /docs y fuerza DEBUG=false)
ENVIRONMENT=development
DEBUG=False

# JWT Configuration
# SECRET_KEY: 32+ caracteres aleatorios. Si falta o es este valor de ejemplo, el backend usa una clave
# temporal y las sesiones se cierran en cada reinicio (ver logs [CONFIG]). Cambiarla cierra todas las sesiones.
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
# Duración de la sesión en minutos (5 a 43200). 10080 = 7 días.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS: orígenes exactos, sin comodines. En producción el frontend usa el proxy de Next.js y no lo necesita.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY: clave secreta (service_role) SOLO del backend. Nunca en Vercel ni en variables NEXT_PUBLIC_.
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Database (Optional if using Supabase)
DATABASE_URL=postgresql://user:password@localhost/dbname

# Correo transaccional (Brevo) - códigos de verificación y de recuperación
# 1) Crea una API key en Brevo: SMTP & API → API Keys
# 2) Verifica el remitente en Brevo: Senders, Domains & Dedicated IPs → Senders
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=tu-remitente-verificado@ejemplo.com
FROM_NAME=Finanzy

# Asistente con Claude (CHG-010, ADR-006). Opcional: sin clave el asistente responde 503 y el resto funciona igual.
# Crea la clave en https://platform.claude.com/settings/keys (solo en Railway, nunca en Vercel). Tiene costo por uso.
ANTHROPIC_API_KEY=
# Modelo: Haiku es el más económico
ANTHROPIC_MODEL=claude-haiku-5-5
# Topes diarios de preguntas (control de costo, INV-024)
ASISTENTE_PREGUNTAS_POR_USUARIO_DIA=30
ASISTENTE_PREGUNTAS_TOTALES_DIA=300

# WhatsApp con IA (CHG-014, ADR-007). Opcional: sin estas variables el webhook no hace nada.
# Cómo obtenerlas: docs/WHATSAPP.md. Solo en Railway, nunca en Vercel.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Topes diarios de mensajes procesados (control de costo, INV-030)
WHATSAPP_MENSAJES_POR_DIA=50
WHATSAPP_MENSAJES_TOTALES_DIA=300

# --- Monitor de consumos del Dueño (CHG-017, ADR-008). Todo opcional ---
# Correo del Dueño (único que ve el Monitor). Vacío = nadie lo ve (404 para todos). No lo escribas en el código.
OWNER_EMAIL=
# Tokens PROPIOS del Monitor, distintos de los de envío/escritura y con el menor permiso que ofrezca cada plataforma.
# Sin un token (o sin su id), esa plataforma aparece "no disponible".
MONITOR_RAILWAY_TOKEN=
MONITOR_RAILWAY_PROJECT_ID=
MONITOR_ANTHROPIC_ADMIN_KEY=
MONITOR_META_TOKEN=
MONITOR_META_WABA_ID=
MONITOR_VERCEL_TOKEN=
MONITOR_VERCEL_TEAM_ID=
MONITOR_BREVO_KEY=
