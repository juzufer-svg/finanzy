# FastAPI Configuration
ENVIRONMENT=development
DEBUG=True

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Database (Optional if using Supabase)
DATABASE_URL=postgresql://user:password@localhost/dbname

# Correo transaccional (Brevo) - códigos de verificación y de recuperación
# 1) Crea una API key en Brevo: SMTP & API → API Keys
# 2) Verifica el remitente en Brevo: Senders, Domains & Dedicated IPs → Senders
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=tu-remitente-verificado@ejemplo.com
FROM_NAME=Finanzy
